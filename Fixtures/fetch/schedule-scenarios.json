{
  "_fixture": {
    "synthetic": true,
    "license": "redistributable",
    "note": "Hand-authored schedule scenarios. No host here is resolved: every name is answered by a stub resolver and every response comes from a stub transport, so the suite performs no DNS lookup and opens no socket. The names are IANA documentation names and the addresses are the addresses the acquisition policy is required to permit; a reserved or private address would be refused by the policy before the schedule could be exercised at all. requires_overlap is how many document requests the case's transport holds in flight together before answering any of them, so a case that claims parallelism cannot pass on a serial schedule. concurrent_offers_are_race_decided marks the one case where two targets can offer the same bytes at the same time: which offer stores them is decided by arrival order, so only the multiset of outcomes is asserted there."
  },
  "limits": {
    "max_in_flight": 3,
    "max_in_flight_per_host": 1,
    "minimum_host_delay_seconds": 0,
    "attempts_per_target": 2
  },
  "resolver_answers": {
    "example.com": [
      "93.184.216.34"
    ],
    "example.org": [
      "93.184.216.35"
    ],
    "example.net": [
      "93.184.216.36"
    ],
    "intranet.example.com": [
      "10.0.0.5"
    ]
  },
