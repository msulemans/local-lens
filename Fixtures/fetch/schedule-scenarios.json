    {
      "id": "identical-bytes-from-two-hosts-are-one-snapshot",
      "why": "Two origins publishing identical bytes in one batch must resolve to one snapshot with both source identities and both requested URLs recorded on it. Which of the two offers the bytes first is decided by arrival order and is therefore not part of the contract: what is contractual is that exactly one snapshot exists, that exactly one offer is reported as a duplicate, and that both identities survive.",
      "limits_override": {
        "max_in_flight": 2,
        "max_in_flight_per_host": 1
      },
      "targets": [
        {
          "source_id": "src-alpha",
          "url": "https://example.com/mirror"
        },
        {
          "source_id": "src-beta",
          "url": "https://example.org/mirror"
        }
