{
  "_fixture": {
    "synthetic": true,
    "license": "redistributable",
    "shape": "DiagnosticFixture",
    "note": "Hand-authored diagnostic scenarios. Every body is written here, every host is a non-resolvable documentation name, and extraction is a pure function of the bytes, so the suite opens no socket and reads no live page. Each entry freezes the measurable facts the diagnostic must report, so a diagnostic that stops counting a fact fails here rather than quietly reporting less."
  },
  "source_id": "diagnostics-fixture",
  "policy": {
    "maximum_bytes": 4096,
    "extractor_version": "html-extractor-1"
  },
